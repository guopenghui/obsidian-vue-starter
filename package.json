{
    "name": "obsidian-sample-plugin",
    "version": "1.0.1",
    "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
    "main": "main.js",
    "scripts": {
        "build": "npm run check && npm run lint && vite build --mode production",
        "check": "vue-tsc -p tsconfig.app.json --noEmit --skipLibCheck",
        "dev": "vite build --mode development",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "version": "node version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "vue": "^3.5.26"
    },
    "devDependencies": {
        "@types/node": "^22.17.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitejs/plugin-vue-jsx": "^5.1.3",
        "@vue/tsconfig": "^0.8.1",
        "obsidian": "^1.11.0",
        "oxlint": "^1.38.0",
        "tslib": "2.8.1",
        "typescript": "~5.9.3",
        "vite": "^8.0.0-0",
        "vue-tsc": "^3.1.4"
    }
}
